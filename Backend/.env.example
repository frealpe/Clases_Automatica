# Plantilla de Variables de Entorno Servidor NestJS
PORT=3000
DATABASE_URL=postgresql://usuario:password@localhost:5432/algebra_lineal_db
JWT_SECRET=super_secret_jwt_key_unicauca_2026
CORS_ORIGIN=*

# SMTP para envío real de correos (recuperación de contraseña, alertas de inasistencias).
# Si SMTP_HOST queda vacío, el servidor solo loguea una advertencia y no falla.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@unicauca.edu.co
