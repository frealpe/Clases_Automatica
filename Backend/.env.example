# Plantilla de Variables de Entorno Servidor NestJS
PORT=3000
DATABASE_URL=postgresql://usuario:password@localhost:5432/algebra_lineal_db

# OBLIGATORIO. El backend NO arranca si falta o es demasiado corto (< 16 caracteres).
# Genera uno único por entorno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Cambiarlo invalida todas las sesiones activas (los usuarios deben volver a iniciar sesión).
JWT_SECRET=

# Orígenes permitidos para CORS, separados por comas (p. ej. https://tu-dominio). Nunca '*'.
# Si se deja vacío, solo se permiten orígenes localhost de desarrollo.
CORS_ORIGIN=

# Contraseña inicial del superusuario semilla, solo para el primer arranque en una BD vacía.
# Si se deja vacío, no se crea la fila semilla del superusuario.
SEED_SUPERUSER_PASSWORD=

# Contraseña de la cuenta demo de estudiante (estudiante@unicauca.edu.co). Opcional;
# si se deja vacío, la cuenta demo no se crea.
SEED_DEMO_STUDENT_PASSWORD=

# SMTP para envío real de correos (recuperación de contraseña, alertas de inasistencias).
# Si SMTP_HOST queda vacío, el servidor solo loguea una advertencia y no falla.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@unicauca.edu.co
